# Copy to .env and fill in what you need. Never commit .env.
# With nothing set, the app runs fully offline: rule-based agent + hashing embeddings.

# --- LLM: "auto" uses Anthropic if its key is set, else OpenAI, else offline ---------
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible server, e.g. Mistral (https://api.mistral.ai/v1) or Ollama (http://host.docker.internal:11434/v1)
OPENAI_BASE_URL=

# --- Embeddings: "auto" uses the OpenAI-compatible API if a key is set, else hashing --
EMBEDDING_PROVIDER=auto
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
# Must match the model. text-embedding-3-* is shortened to this size server-side.
# For Mistral: EMBEDDING_BASE_URL=https://api.mistral.ai/v1, EMBEDDING_MODEL=mistral-embed, EMBEDDING_DIM=1024
# After changing provider/model/dim, re-ingest with:  python -m ops_assistant.ingest --reset
EMBEDDING_DIM=512

# --- Retrieval / agent ---------------------------------------------------------------
RETRIEVAL_MODE=hybrid
TOP_K=5
MAX_TOOL_CALLS=4

# --- Local (non-Docker) runs ---------------------------------------------------------
DATABASE_URL=postgresql://ops:ops@localhost:5432/ops
DATA_DIR=../data/sample
